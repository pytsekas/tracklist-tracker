# Copy to .env before running docker compose up
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=tracklists
MYSQL_USER=tracklists
MYSQL_PASSWORD=tracklists

DB_HOST=db
DB_PORT=3306
DB_NAME=tracklists
DB_USER=tracklists
DB_PASSWORD=tracklists

PORT=3000
APP_PORT=3000
MAX_UPLOAD_MB=32

# Nothing in this project reads this file automatically at runtime -- no
# loader wires it into the process. These two names are exactly what the
# server checks in its runtime variables: set them yourself before running
# the command, e.g.
#
#   DEV_USER_EMAIL=you@example.com npm run dev
#
# or add an `environment:` entry for it under the app service in
# docker-compose.yml. On Cloud Run this is ignored; the identity comes from
# the signed IAP assertion instead.
DEV_USER_EMAIL=dev@localhost

# Annotation store driver. Defaults to sqlite locally and firestore on Cloud Run.
# Same as above -- set it yourself; this file does not wire it in for you.
# ANNOTATIONS_DRIVER=sqlite
# ANNOTATIONS_DB=data/annotations.sqlite
